# Configuración del backend. Copiar a backend/.env y rellenar; el .env no se
# versiona. Qué es cada variable, con detalle, en docs/ENTORNOS.md.

NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL / Supabase) ---
# Sin PG_HOST, PG_USER o PG_PASSWORD el servidor no arranca, y lo dice.
# Supabase no publica el host directo db.<ref>.supabase.co (no resuelve por DNS):
# se entra por el pooler de la región del proyecto, y el usuario lleva la
# referencia del proyecto detrás del punto.
PG_HOST=aws-0-us-east-2.pooler.supabase.com
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres.<ref-del-proyecto>
# Entre comillas si lleva '#': sin ellas dotenv lo toma como un comentario.
PG_PASSWORD="change-me"

# --- Sesión y orígenes ---
# Firma las cookies de sesión. Obligatoria en producción.
SESSION_SECRET=change-me
CORS_ORIGIN=http://localhost:5173
# Solo si el frontend se sirviera desde otro dominio que la API: marca la cookie
# SameSite=None y Secure, y exige HTTPS en los dos extremos. Con todo bajo el
# mismo dominio, como en Render, se deja en false.
COOKIE_CROSS_SITE=false
# En producción Express sirve el frontend compilado desde esta ruta, relativa al
# directorio desde el que arranca el proceso (en Render, la raíz del repositorio).
FRONTEND_DIST=../frontend/dist

# --- Contraseñas heredadas ---
# Con false (por defecto) una cuenta cuya contraseña esté guardada en texto plano
# no puede iniciar sesión: se le pide restablecerla. Ponerlo en true solo durante
# una ventana de migración: mientras esté encendido, el primer login de cada
# cuenta heredada cifra su contraseña con bcrypt. Cuando no queden, volver a false.
PERMITIR_PASSWORD_PLANO=false

# --- Zoho WorkDrive (opcional) ---
# Subida del inventario de un cliente como hoja de cálculo. Sin estas variables
# la función queda inactiva y el resto del sistema funciona igual.
# ZOHO_DC es el centro de datos de la cuenta: US, EU, IN, AU, JP o CN.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_FOLDER_ID=
ZOHO_DC=US

# --- Ajustes finos (opcionales, con valores por defecto razonables) ---
# HOST=0.0.0.0
# RATE_LIMIT_GENERAL=1000     peticiones por IP cada 15 minutos
# RATE_LIMIT_LOGIN=30         intentos de login por minuto
# DB_CONNECTION_LIMIT=10      conexiones del pool
