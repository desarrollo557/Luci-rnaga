NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=fuiddatosluci
CORS_ORIGIN=http://localhost:5173
# En producción, Express sirve el build del frontend desde /frontend/dist
FRONTEND_DIST=../frontend/dist

# --- Migracion de contrasenas heredadas ---
# Con false (por defecto) una cuenta cuya contrasena este guardada en texto plano
# NO puede iniciar sesion: se le pide restablecerla a un administrador.
# Ponerlo en true solo durante una ventana de migracion controlada: mientras este
# encendido, el primer login de cada cuenta heredada cifra su contrasena con bcrypt
# y la deja migrada. Cuando ya no queden cuentas sin cifrar, volver a false.
PERMITIR_PASSWORD_PLANO=false

# --- Zoho WorkDrive ---
# El inventario documental (FUID) se sube como .xlsx con las 27 columnas oficiales
# a la carpeta ZOHO_FOLDER_ID. ZOHO_WORKSPACE_ID opcional: si está presente, se
# guarda la URL completa del archivo en ZOHO_FILE_ID; si no, se guarda solo el fileId.
ZOHO_CLIENT_ID=change-me
ZOHO_CLIENT_SECRET=change-me
ZOHO_REFRESH_TOKEN=change-me
ZOHO_FOLDER_ID=change-me
ZOHO_WORKSPACE_ID=change-me
ZOHO_DC=US

# --- Rangos UPD (despliegue gradual) ---
RANGOS_UPD_ENFORCE=false
