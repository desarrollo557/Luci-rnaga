NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=fuiddatosluci
CORS_ORIGIN=http://localhost:5173
# En producción, Express sirve el build del frontend desde /frontend/dist
FRONTEND_DIST=../frontend/dist

# --- Zoho WorkDrive ---
# El inventario documental (FUID) se sube como .xlsx con las 27 columnas oficiales
# a la carpeta ZOHO_FOLDER_ID. ZOHO_WORKSPACE_ID opcional: si está presente, se
# guarda la URL completa del archivo en ZOHO_FILE_ID; si no, se guarda solo el fileId.
ZOHO_CLIENT_ID=change-me
ZOHO_CLIENT_SECRET=change-me
ZOHO_REFRESH_TOKEN=change-me
ZOHO_FOLDER_ID=change-me
ZOHO_WORKSPACE_ID=change-me
ZOHO_DC=US

# --- Rangos UPD (despliegue gradual) ---
RANGOS_UPD_ENFORCE=false
